# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key (safe to expose; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# JWT session signing (must match between both apps)
SESSION_SECRET=dev-secret-change-me-in-production
# Optional: share the session cookie across *.tejaverse.org subdomains so users
# stay logged in between Interview Handbook and Code Battle.
# Set to .tejaverse.org in production only. Leave unset for localhost.
COOKIE_DOMAIN=
# Bug reports (Google Apps Script Web App URL → Google Sheet)
GOOGLE_BUG_REPORT_SCRIPT_URL=


# Google OAuth (https://console.cloud.google.com -> Credentials -> OAuth client ID)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID= 
GOOGLE_CLIENT_SECRET=

